# --- Brain ------------------------------------------------------------------
# ollama = free local model on this Mac (default). claude = Anthropic API (paid, needs the key below).
# VA_BRAIN=ollama
# VA_OLLAMA_MODEL=bonsai-2:27b   # any Ollama model with "tools"; see `ollama list`
# VA_THINK=0                     # 1 = reason before answering: smarter but much slower
# VA_NUM_CTX=16384               # context window; lower = faster and less memory
# VA_KEEP_ALIVE=-1               # keep the model loaded forever (instant replies); e.g. 10m to free memory
# VA_LOCAL_MAX_STEPS=15          # tool rounds per request before it stops
# VA_FAST_PATH=1                 # instant replies for simple commands (open/quit app, volume, weather, Settings panes, time)
# VA_HOME_CITY=Boston            # default city for weather (set this so "what's the weather" is instant)
# VA_UNITS=imperial              # imperial | metric

# Only needed when VA_BRAIN=claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# VA_MODEL=claude-opus-5-5
# VA_EFFORT=medium            # low = snappier replies, high = better at long multi-step tasks

# --- Voice ------------------------------------------------------------------
# VA_TTS=kokoro               # kokoro (natural, local) | say (macOS built-in)
# VA_KOKORO_VOICE=am_michael  # am_adam, am_onyx, bm_george, bm_lewis, af_heart, bf_emma ... (a = US, b = UK)
# VA_KOKORO_SPEED=1.1
# VA_VOICE=                   # `say` only; list voices with: say -v '?'
# VA_SPEECH_RATE=190          # `say` only

# --- Listening --------------------------------------------------------------
# VA_NAME=Jarvis
# VA_WAKE_WORD=hey_jarvis     # hey_jarvis | alexa | hey_mycroft | hey_rhasspy
# VA_WAKE_THRESHOLD=0.5       # raise if it triggers by accident, lower if it misses you
# VA_WHISPER_MODEL=small.en   # base.en is faster, medium.en is more accurate
# VA_SILENCE_SECONDS=1.0      # pause that ends your sentence; 0.7 replies sooner but may cut you off
# VA_FOLLOWUP_SECONDS=5
# VA_SESSION_IDLE_MINUTES=10
